{"id": 900110, "t": "Куда ведёт эта улица?"}
{"id": 900123, "t": "Этот кофе слишком крепкий для меня."}
{"id": 900129, "t": "Пахнет здорово! Что ты готовишь?"}
{"id": 900997, "t": "Я хочу пойти с тобой."}
{"id": 902114, "t": "Он вас не понимает."}
{"id": 902144, "t": "Свет движется быстрее звука."}
{"id": 902145, "t": "Ты - милая девочка."}
{"id": 902163, "t": "Не покидай меня!"}
{"id": 902277, "t": "Я не могу есть мясо."}
{"id": 902286, "t": "Это её дом."}
{"id": 902292, "t": "В парке была красивая девушка с чёрными волосами."}
{"id": 902295, "t": "Между прочим, что с ним?"}
{"id": 902301, "t": "Я родился в тысяча девятьсот семьдесят втором году."}
{"id": 902306, "t": "Ты был когда-нибудь в Мексике?"}
{"id": 902316, "t": "Мне очень нравится снег."}
{"id": 902329, "t": "Это хороший вопрос."}
{"id": 902335, "t": "Мужчина ел хлеб."}
{"id": 902336, "t": "Это была мышь."}
{"id": 902340, "t": "Он на её стороне."}
{"id": 902395, "t": "Тараканы - насекомые."}
{"id": 902409, "t": "Это не волшебство."}
{"id": 902413, "t": "Япония находится в Азии."}
{"id": 902440, "t": "Здесь кто-нибудь говорит по-японски?"}
{"id": 902448, "t": "Она ему объяснила, почему опоздала на его вечеринку."}
{"id": 902459, "t": "Печаль уходит со временем."}
{"id": 902461, "t": "Пожалуйста, отпусти мою руку."}
{"id": 902470, "t": "Не волнуйся обо мне."}
{"id": 902587, "t": "Могу я это съесть?"}
{"id": 902623, "t": "Я расспросил его об аварии."}
{"id": 902657, "t": "Я могу летать."}
{"id": 902659, "t": "Не ходи."}
{"id": 902738, "t": "Пожалуйста, искупай ребёнка."}
{"id": 902740, "t": "Он дал собаке кость."}
{"id": 902759, "t": "Полиция информировала нас о происшествии."}
{"id": 902764, "t": "Она только что ушла."}
{"id": 902767, "t": "Она играет на пианино?"}
{"id": 902869, "t": "Она запела."}
{"id": 902872, "t": "Где обувь?"}
{"id": 902961, "t": "Прошлым вечером я читал книгу."}
{"id": 902987, "t": "Он уехал на Хоккайдо."}
{"id": 903002, "t": "Что он сегодня сделал?"}
{"id": 903007, "t": "Говорите, пожалуйста, медленно."}
{"id": 903015, "t": "Она меня знает."}
{"id": 903023, "t": "Оба живы."}
{"id": 903026, "t": "Там никого не было."}
{"id": 903034, "t": "Кошка любит спать возле меня."}
{"id": 903038, "t": "Это моя машина."}
{"id": 903047, "t": "Что ты скажешь на то, чтобы выйти и немного прогуляться?"}
{"id": 903051, "t": "У меня сложное дело, которое я хочу обсудить с вами."}
{"id": 903054, "t": "Дай подумать минутку."}
{"id": 903095, "t": "У меня кашель и немного лихорадит."}
{"id": 903107, "t": "В Испании демократия с 1975 года."}
{"id": 903114, "t": "Не валяй дурака!"}
{"id": 903116, "t": "Не прикидывайся!"}
{"id": 903123, "t": "Как вы считаете?"}
{"id": 903129, "t": "Как ты вышел на эти редкие книги?"}
{"id": 903131, "t": "Почему ты приходил сюда сегодня утром?"}
{"id": 903133, "t": "Почему ты одинок?"}
{"id": 903143, "t": "Вы можете смотреть телевидение."}
{"id": 903146, "t": "Ты играл в теннис?"}
{"id": 903149, "t": "Я слышал, что ты хороший теннисный игрок."}
{"id": 903150, "t": "Ты оставался дома готовиться к экзамену?"}
{"id": 903151, "t": "Вы пришли в удобное время."}
{"id": 903154, "t": "Вы умеете играть в шахматы?"}
{"id": 903155, "t": "Нет причины чувствовать себя ниже других."}
{"id": 903156, "t": "Вас все уважают."}
{"id": 903162, "t": "Тебе лучше бросить курение."}
{"id": 903165, "t": "Ведь ты же не куришь, да?"}
{"id": 903175, "t": "Всё, что тебе нужно сделать, - это заполнить этот бланк."}
{"id": 903181, "t": "Всё, что тебе нужно сделать, - это сесть здесь и ответить на вопросы доктора."}
{"id": 903187, "t": "У тебя много времени?"}
{"id": 903189, "t": "Чем больше книг вы прочитаете, тем больше вы будете знать."}
{"id": 903199, "t": "Не нужно говорить так громко."}
{"id": 903205, "t": "Как ты получил такую большую сумму денег?"}
{"id": 903232, "t": "Вам не следует заставлять их ждать так долго."}
{"id": 903236, "t": "Вам не нужно так поспешно идти."}
{"id": 903247, "t": "Вам не нужно работать так усердно."}
{"id": 903261, "t": "Ты можешь сделать это."}
{"id": 903262, "t": "Ты купил это сегодня или вчера?"}
{"id": 903263, "t": "Не упускай возможности увидеть это."}
{"id": 903275, "t": "Как вы это сможете объяснить?"}
{"id": 903293, "t": "Вы знаете, что это?"}
{"id": 903302, "t": "Что вы заключили из этого?"}
{"id": 903305, "t": "Вам лучше спросить его заранее, сколько это будет стоить."}
{"id": 903311, "t": "Тебе следует прочитать эту книгу."}
{"id": 903325, "t": "У тебя есть та бутылка?"}
{"id": 903348, "t": "У тебя были уроки пианино в тот день?"}
{"id": 903353, "t": "Когда ты получил телеграмму?"}
{"id": 903360, "t": "Вы за это предложение?"}
{"id": 903379, "t": "Можете открыть окно."}
{"id": 903382, "t": "Нужно встать в очередь, чтобы купить билет."}
{"id": 903389, "t": "Вы верите свидетельским показаниям?"}
{"id": 903761, "t": "Это всё?"}
{"id": 903762, "t": "Это всё, что есть?"}
{"id": 904313, "t": "Том, отработав целый день, хотел отдохнуть."}
{"id": 904332, "t": "На горе растут дубы?"}
{"id": 904337, "t": "На холме стоит большой дом."}
{"id": 904343, "t": "Возможно, ты и прав."}
{"id": 904348, "t": "Пожалуйста, закрой дверь."}
{"id": 904354, "t": "У подножия холма есть красивое озеро."}
{"id": 904355, "t": "Увидев меня, они внезапно замолчали."}
{"id": 904357, "t": "Множество низких деревьев растут на холме."}
{"id": 904359, "t": "С холма мы можем видеть красивый вид моря."}
{"id": 904360, "t": "Вернул ли ты книгу в библиотеку?"}
{"id": 904364, "t": "Мне стало намного легче после того, как я высказал все, что хотел."}
{"id": 904398, "t": "Вы это когда закончили?"}
{"id": 904402, "t": "Муха может ходить по потолку."}
{"id": 904470, "t": "Я вам советую начать сразу."}
{"id": 904500, "t": "Эта кошка очень милая."}
{"id": 904552, "t": "Мы опоздали из-за шторма."}
{"id": 904570, "t": "Вам следует соблюдать предписания доктора."}
{"id": 904577, "t": "Лучше проконсультируйтесь у врача."}
{"id": 904590, "t": "Лучше спросите совета у доктора."}
{"id": 904600, "t": "Ты сделал это!"}
{"id": 904613, "t": "Возвращайся домой, прежде чем стемнеет."}
{"id": 904614, "t": "Ты в безопасности."}
{"id": 904642, "t": "Вы подаёте дурной пример."}
{"id": 904643, "t": "Вы специально разбили окно или случайно?"}
{"id": 904648, "t": "Вы должны возместить ущерб."}
{"id": 904650, "t": "Разве ты не любишь яблоки?"}
{"id": 904673, "t": "У тебя есть хороший шанс поправить дела."}
{"id": 904729, "t": "Вы по-настоящему хороший работник."}
{"id": 904761, "t": "Для тебя было бы лучше прочитать побольше книг."}
{"id": 904764, "t": "Ты лучше должен знать."}
{"id": 904767, "t": "Ты должен больше учиться."}
{"id": 904769, "t": "Всё, что тебе нужно делать, - это работать усерднее."}
{"id": 904770, "t": "Будь осторожнее."}
{"id": 904771, "t": "Тебе нужно быть осторожным."}
{"id": 904772, "t": "Жаль, что ты не начал раньше."}
{"id": 904776, "t": "Тебе нужно было выполнить это давным-давно."}
{"id": 904778, "t": "Какой поезд идёт в центр города?"}
{"id": 904779, "t": "Каким поездом поедешь?"}
{"id": 904780, "t": "Вам следовало бы аккуратнее относиться к своему здоровью."}
{"id": 904942, "t": "Она сделала мне подарок."}
{"id": 904950, "t": "Они в гимнастическом зале?"}
{"id": 904955, "t": "Они собрались в гимнастическом зале."}
{"id": 904957, "t": "Они устали ждать."}
{"id": 904962, "t": "У них не было выбора, а только отступление."}
{"id": 904964, "t": "Они разговаривают в столовой."}
{"id": 904965, "t": "Они ворвались через кухонное окно."}
{"id": 904966, "t": "У них большой дом."}
{"id": 905404, "t": "Вы должны пройти со мной."}
{"id": 905427, "t": "Этот поезд ходит между Токио и Хаката."}
{"id": 905970, "t": "Разбуди меня в восемь."}
{"id": 906082, "t": "Я ей сказал раз и навсегда, что не пойду с ней по магазинам."}
{"id": 906084, "t": "Извиняюсь, что был так груб."}
{"id": 906288, "t": "Мне нравится синяя. Сколько она стоит?"}
{"id": 906302, "t": "Сильный огонь превратил весь город в пепел."}
{"id": 906319, "t": "Я мальчик стыдливый."}
{"id": 906441, "t": "Ты не должен ему доверять."}
{"id": 906564, "t": "Том умеет управлять практически любым транспортным средством."}
{"id": 906570, "t": "Это из-за вас я изувечен."}
{"id": 906572, "t": "Сад был укрыт опавшей листвой."}
{"id": 906576, "t": "Город моего рождения прекрасен."}
{"id": 906579, "t": "Что-то случилось с моим правым глазом."}
{"id": 907140, "t": "Три мальчика посмотрели друг на друга."}
{"id": 907152, "t": "Она была в восьмом классе."}
{"id": 907155, "t": "Она работает с девяти."}
{"id": 907157, "t": "У нее такая же сумка, как у тебя."}
{"id": 907158, "t": "Она примерно твоего роста."}
{"id": 907160, "t": "Она одолжит тебе книгу."}
{"id": 907161, "t": "Она два часа тебя ждала."}
{"id": 907163, "t": "Она знает твой номер телефона?"}
{"id": 907164, "t": "Она не такая умная, как ты."}
{"id": 907165, "t": "Она старше тебя на два года."}
{"id": 907166, "t": "Я сомневаюсь, что она тебя любит."}
{"id": 907168, "t": "Вы моете руки перед едой?"}
{"id": 907172, "t": "Я могу водить машину, а Том нет."}
{"id": 907228, "t": "Здесь продаются билеты на концерт."}
{"id": 907230, "t": "Париж — один из самых больших городов в мире."}
{"id": 907282, "t": "Сейчас судят убийцу."}
{"id": 907386, "t": "В этой комнате нет стульев."}
{"id": 907696, "t": "Надеюсь, завтра дождя не будет."}
{"id": 907698, "t": "Что тебя заставляет так думать?"}
{"id": 907701, "t": "Где ванная комната?"}
{"id": 907707, "t": "Нет большего дурака, чем старый дурак."}
{"id": 907738, "t": "Я сейчас должен это сделать?"}
{"id": 907977, "t": "Когда я проснулся, в моей комнате был взломщик."}
{"id": 907997, "t": "Это блестящая идея."}
{"id": 908000, "t": "Пожалуйста, говорите со мной по-английски."}
{"id": 908012, "t": "Держите детей подальше от пруда."}
{"id": 908346, "t": "Уже скоро ухожу."}
{"id": 908351, "t": "Концерт длился около трёх часов."}
{"id": 908355, "t": "Не трогай это."}
{"id": 908357, "t": "Я пытался проследовать за ней, но она ускользнула."}
{"id": 908362, "t": "Я старше других учеников в моём классе."}
{"id": 908369, "t": "Мы никогда бы бываем настолько счастливы или несчастны, как мы себе представляем."}
{"id": 908388, "t": "Ты сделала то, что и была обязана."}
{"id": 908472, "t": "Враг атаковал весь день."}
{"id": 908478, "t": "Атака врага закончилась с рассветом."}
{"id": 908498, "t": "Враг занял форт."}
{"id": 908581, "t": "Мы должны уважать традиции."}
{"id": 908590, "t": "Ты бегаешь ежедневно?"}
{"id": 908804, "t": "Возможно, вы правы."}
{"id": 908833, "t": "Здесь не о чем беспокоиться."}
{"id": 908919, "t": "Разрешите откланяться."}
{"id": 909604, "t": "У той женщины две сумки."}
{"id": 909606, "t": "Где мне смогут помочь?"}
{"id": 909608, "t": "Преподаватель строг со своими курсантами."}
{"id": 909619, "t": "Этот зал вмещает две тысячи людей."}
{"id": 909978, "t": "Он вернулся из Китая."}
{"id": 910670, "t": "Он ненавидит бегать."}
{"id": 910681, "t": "Вам нужны ключи?"}
{"id": 910684, "t": "Как вам мой новый костюм?"}
{"id": 910692, "t": "Я ужинаю в семь пятнадцать."}
{"id": 910750, "t": "Разом все ученики начали разговаривать."}
{"id": 910756, "t": "Попробуй быть толерантным к остальным."}
{"id": 910802, "t": "Пожалуйста, обратите внимание."}
{"id": 911357, "t": "Стыдись!"}
{"id": 911635, "t": "Пожалуй, так."}
{"id": 912692, "t": "У нас нет горячей воды, потому что прорвало трубы."}
{"id": 912694, "t": "Трубы в ванной комнате забились нечистотами."}
{"id": 912695, "t": "Вода вытекала из поврежденной трубы."}
{"id": 912700, "t": "Если вы посадите яблочное семечко, оно может вырасти в дерево."}
{"id": 912705, "t": "Мне не нравится ваше невежливое поведение."}
{"id": 912711, "t": "Моя мама учила меня, что показывать пальцем - это невежливо."}
{"id": 912712, "t": "Укус гремучей змеи ядовит."}
{"id": 912716, "t": "У меня несколько книг."}
{"id": 912719, "t": "Кто этот мальчик, который там плавает?"}
{"id": 912962, "t": "Физика - это научная дисциплина."}
{"id": 912997, "t": "Ничего не бойся."}
{"id": 913066, "t": "Как давно ты за границей?"}
{"id": 913098, "t": "Всё в порядке."}
{"id": 913416, "t": "Я увидела луну над крышей."}
{"id": 913883, "t": "Мой отец в саду."}
{"id": 913904, "t": "Собака укусила меня за руку."}
{"id": 914237, "t": "Вчера я купил книгу."}
{"id": 914265, "t": "Это закон."}
{"id": 914280, "t": "Дарю тебе книгу."}
{"id": 914282, "t": "У вас болит голова?"}
{"id": 914283, "t": "Вы любите белый шоколад?"}
{"id": 914286, "t": "Золото тяжелее железа."}
{"id": 914295, "t": "В комнате было жарко."}
{"id": 914303, "t": "Люблю изучать историю."}
{"id": 914326, "t": "Я видел Лиз сегодня утром."}
{"id": 914399, "t": "После короткой борьбы они победили."}
{"id": 914403, "t": "Они помогли ему попасть в Канаду."}
{"id": 914404, "t": "Они составили список имён."}
{"id": 914423, "t": "Они оскорбили его и его жену."}
{"id": 914432, "t": "Они не говорили по-испански."}
{"id": 914436, "t": "Они погибли, пытаясь спасти других."}
{"id": 914440, "t": "Они отправили его в тюрьму в 1925 году."}
{"id": 914980, "t": "Ты действительно умеешь плавать?"}
{"id": 915134, "t": "Твоя мать пытается разбить наш брак."}
{"id": 915135, "t": "Твоя мать скоро вернётся."}
{"id": 915144, "t": "Твоя мать очень молода, правда?"}
{"id": 915148, "t": "Передай, пожалуйста, своей матери мои лучшие пожелания."}
{"id": 915247, "t": "Само заживёт."}
{"id": 915248, "t": "Само пройдёт."}
{"id": 915260, "t": "Весь день шёл сильный дождь."}
{"id": 915290, "t": "Ей случалось играть с ним в теннис."}
{"id": 915595, "t": "Мне просто хотелось услышать звук твоего голоса."}
{"id": 915604, "t": "Это мой выбор."}
{"id": 915659, "t": "Какой фрукт в Японии самый вкусный?"}
{"id": 915679, "t": "Отец навестил моего дядю в больнице."}
{"id": 916129, "t": "У него крыша съехала."}
{"id": 916450, "t": "Как ты провел свои зимние каникулы?"}
{"id": 916465, "t": "Тебе не стоило платить по этому счету."}
{"id": 917458, "t": "Краткость — сестра таланта."}
{"id": 917921, "t": "Он дал своим детям хорошее образование."}
{"id": 918531, "t": "Посмотрим-ка."}
{"id": 918533, "t": "Я пошёл выпить пива с друзьями."}
{"id": 918534, "t": "Он провёл утро, читая книгу."}
{"id": 919998, "t": "Мне повезло."}
{"id": 920005, "t": "Я опасался, что могу уснуть за рулём."}
{"id": 920057, "t": "Хочу лететь над облаками."}
{"id": 920066, "t": "Я сотрудник коммерческого отдела."}
{"id": 920101, "t": "Я пробыл дома целый день, вместо того чтобы сходить в кино."}
{"id": 920107, "t": "Хочу сходить в кино."}
{"id": 920248, "t": "Чем Вас ударили?"}
{"id": 920818, "t": "У неё есть две тысячи книг."}
{"id": 920831, "t": "Чепуха."}
{"id": 921289, "t": "Это полный бред!"}
{"id": 922111, "t": "И то правда."}
{"id": 922360, "t": "Мы должны сохранять спокойствие."}
{"id": 922676, "t": "На Тома всегда можно положиться."}
{"id": 922677, "t": "Ты друг Тома, да?"}
{"id": 922679, "t": "Сравни свой ответ с Томовым."}
{"id": 922681, "t": "К нашему удивлению, Том пришёл к нам на вечеринку с Машей."}
{"id": 922808, "t": "Здесь покоится его прах."}
{"id": 922982, "t": "Моя мама заставила меня выпить лекарство."}
{"id": 923498, "t": "Он придёт сюда в шесть часов."}
{"id": 923550, "t": "Если укусит - не жалуйся."}
{"id": 923687, "t": "Он врач?"}
{"id": 923688, "t": "Он доктор наук?"}
{"id": 923691, "t": "Он доктор?"}
{"id": 923740, "t": "Ты спешишь?"}
{"id": 923750, "t": "Спокойной ночи!"}
{"id": 923765, "t": "Я так не хотел."}
{"id": 924419, "t": "Она живёт в Нью-Йорке."}
{"id": 924420, "t": "У меня есть несколько друзей."}
{"id": 924421, "t": "Почему ты такой грустный?"}
{"id": 924423, "t": "Я люблю природу."}
{"id": 924424, "t": "У меня есть пластиковый стакан."}
{"id": 924938, "t": "Я всегда с трудом запоминаю имена."}
{"id": 924964, "t": "Благодарим Вас за заполнение этой формы."}
{"id": 924990, "t": "Он немного отдохнул."}
{"id": 924995, "t": "Ты оставил на чай?"}
{"id": 925005, "t": "Нам нужно ожидать худшего."}
{"id": 925009, "t": "Они даже не знают почему."}
{"id": 925047, "t": "Кто идёт со мной?"}
{"id": 925186, "t": "У меня два брата и одна сестра."}
{"id": 925360, "t": "Пусть сбудутся все твои мечты!"}
{"id": 925367, "t": "Мне стало жаль её, когда я выслушал её рассказ."}
{"id": 925375, "t": "Прочти низ страницы."}
{"id": 925376, "t": "Я оставил свой словарь внизу."}
{"id": 925378, "t": "Цена оказалась ниже, чем я думал."}
{"id": 925381, "t": "Жизнь полна взлётов и падений."}
{"id": 925382, "t": "Какие места Вам нравятся?"}
{"id": 925383, "t": "Ужин готов."}
{"id": 925392, "t": "Работа почти окончена."}
{"id": 925526, "t": "Эта картина Рембрандта - шедевр."}
{"id": 926034, "t": "Я польщена."}
{"id": 926118, "t": "Циркулировали слухи о поражении."}
{"id": 926120, "t": "Том ищет работу."}
{"id": 926604, "t": "Я выучил 2000 английских слов."}
{"id": 926802, "t": "Двенадцать - чётное число."}
{"id": 926810, "t": "Её волосы длинные."}
{"id": 926985, "t": "Люблю спорт."}
{"id": 927026, "t": "Сколько котов в этом доме?"}
{"id": 927052, "t": "Считаете ли вы, что телевидение приносит вред детям?"}
{"id": 927168, "t": "Она - гений."}
{"id": 927206, "t": "Дверь открыта."}
{"id": 927209, "t": "У вас есть деньги?"}
{"id": 927210, "t": "Ты ходишь в начальную школу?"}
{"id": 927379, "t": "Мой трёхлетний ребёнок действительно испытывает моё терпение."}
{"id": 927380, "t": "Она любит Тома больше, чем я."}
{"id": 928226, "t": "Это значит \"да\" или \"нет\"?"}
{"id": 928617, "t": "Эта игрушка сделана из дерева."}
{"id": 928756, "t": "Я решил поехать учиться за границу."}
{"id": 928764, "t": "Эта статья осмеивает вегетарианцев."}
{"id": 929000, "t": "Они убьют меня."}
{"id": 929951, "t": "Так и есть."}
{"id": 929975, "t": "Это — смешная ситуация."}
{"id": 929980, "t": "Забавно, что ты так сказал."}
{"id": 929986, "t": "Оставь себе сдачу."}
{"id": 931834, "t": "Как происходит, что мы видим ясно всё окружающее?"}
{"id": 931836, "t": "Спрашивается, как это может быть?"}
{"id": 932004, "t": "Она плакала."}
{"id": 932137, "t": "Я не принадлежу ни к какому клубу."}
{"id": 932256, "t": "Я обеспокоен сухим кашлем моей жены."}
{"id": 932588, "t": "Это как ходить по Луне."}
{"id": 932602, "t": "Выходя из комнаты, пожалуйста, убедитесь, что вы выключили свет."}
{"id": 932616, "t": "Здания были повреждены бурей, случившейся вчера ночью."}
{"id": 932623, "t": "Убедитесь, что Вы заперли все двери, прежде чем выйти из дома."}
{"id": 932635, "t": "Мои руки окоченели от холода."}
{"id": 932677, "t": "Вы осуществляете доставку по воскресеньям?"}
{"id": 932691, "t": "Ты купил эту книгу?"}
{"id": 932699, "t": "Я спросил у него, почему ему грустно."}
{"id": 932708, "t": "Ты знаешь, какая книга сейчас хорошо продается?"}
{"id": 932726, "t": "Пожалуйста, напишите здесь своё имя."}
{"id": 932729, "t": "Луи Пастер экспериментировал над микробами."}
{"id": 932730, "t": "Ура! Сегодня пятница!"}
{"id": 932731, "t": "Ты голоден?"}
{"id": 932733, "t": "Я позвоню тебе, как приеду в аэропорт."}
{"id": 932734, "t": "Это ненормально, есть так много."}
{"id": 932740, "t": "Насколько длинный этот мост?"}
{"id": 932742, "t": "По сравнению с окружающими его людьми, он выглядел очень счастливым."}
{"id": 932754, "t": "Мы живём в век технологий."}
{"id": 932755, "t": "Мой дом - моя крепость."}
{"id": 932758, "t": "У моего дома есть маленький дворик."}
{"id": 932760, "t": "Мне жаль, но это просто невозможно."}
{"id": 932806, "t": "Философию не выучишь за полгода."}
{"id": 932811, "t": "Он хочет быть теннисистом."}
{"id": 932820, "t": "Он играл в теннис."}
{"id": 932823, "t": "Вместо игры в теннис он отправился на рыбалку."}
{"id": 932826, "t": "Он любит играть в теннис."}
{"id": 932834, "t": "Он любит смотреть телевизор."}
{"id": 932835, "t": "Пожалуйста, закрой дверь тихо."}
{"id": 932841, "t": "Вчера шел дождь."}
{"id": 932842, "t": "До вчерашнего дня я ничего об этом не знал."}
{"id": 932843, "t": "Вчера я весь день спал, потому что было воскресенье."}
{"id": 932844, "t": "У нас вчера был экзамен по биологии."}
{"id": 932846, "t": "Вчера я пропустил последний автобус."}
{"id": 932847, "t": "У нас вчера были гости."}
{"id": 932848, "t": "Погода вчера была идеальная."}
{"id": 932856, "t": "Сомневаюсь, что он придет вовремя."}
{"id": 934134, "t": "Я считаю, что Бетховен — величайший композитор из когда-либо живших."}
{"id": 934138, "t": "Актер скончался на пике популярности."}
{"id": 934139, "t": "Это золотая монета."}
{"id": 934146, "t": "Она не хочет, чтобы он покупал дорогое обручальное кольцо."}
{"id": 934149, "t": "Поверни налево на первом светофоре."}
{"id": 934151, "t": "Я могу выдержать всё, кроме искушений."}
{"id": 934152, "t": "Америка состоит из пятидесяти штатов."}
{"id": 934154, "t": "Вершина той горы плоская."}
{"id": 934159, "t": "Моя мама не может читать без очков."}
{"id": 934161, "t": "Её попросили дать ему немного денег."}
{"id": 934162, "t": "У каждого из них была машина."}
{"id": 934168, "t": "Как долго отсюда ехать на велосипеде до вашего дома?"}
{"id": 934169, "t": "Она живёт за границей."}
{"id": 934171, "t": "Чья это ручка?"}
{"id": 934172, "t": "Мне не нравится такой климат."}
{"id": 934525, "t": "До тех пор пока вы довольны, мне всё равно."}
{"id": 934940, "t": "Кто ваш юрист?"}
{"id": 935886, "t": "Ноль стоит перед единицей."}
{"id": 935890, "t": "Я так устал!"}
{"id": 935892, "t": "Придя домой, я сразу лёг спать."}
{"id": 935893, "t": "Вчера был сильный дождь."}
{"id": 935944, "t": "Иди на хуй!"}
{"id": 936911, "t": "Я принесу тебе счастье."}
{"id": 937304, "t": "Он стоит перед дверью."}
{"id": 937305, "t": "Ты не мог бы говорить чуть погромче?"}
{"id": 937306, "t": "Пожалуйста, завтра разбуди меня в шесть утра."}
{"id": 937311, "t": "На твоём месте я бы так и поступил."}
{"id": 937630, "t": "Никогда больше такого не делай."}
{"id": 937872, "t": "Я люблю Вас."}
{"id": 937922, "t": "Что мы приготовим поесть?"}
{"id": 937925, "t": "Заведующий отделом принял предложение."}
{"id": 937944, "t": "Когда я вернулся, мой автомобиль исчез."}
{"id": 937955, "t": "Где находится ближайшая станция метро?"}
{"id": 937960, "t": "Где находится ближайший музей?"}
{"id": 937976, "t": "Она - нехороший человек."}
{"id": 937981, "t": "У меня есть солнцезащитные очки."}
{"id": 938409, "t": "В ближайшем будущем мы можем встретиться вновь."}
{"id": 938415, "t": "Этот дом скоро развалится."}
{"id": 938420, "t": "Всё равно, каким ты был пьяным, Гёте был поэт!"}
{"id": 938551, "t": "У нас есть домашний любимец - колли."}
{"id": 938553, "t": "Наша команда проиграла все игры."}
{"id": 938554, "t": "Наша команда победила \"Львов\" со счётом 3:0."}
{"id": 938625, "t": "Отпуск уже закончился."}
{"id": 938693, "t": "Боль была невыносима."}
{"id": 938699, "t": "Скоро будет весна."}
{"id": 938714, "t": "Ты учишься или работаешь?"}
{"id": 938733, "t": "Слишком поздно."}
{"id": 938739, "t": "Я люблю и кошек, и собак."}
{"id": 938850, "t": "Все старые журналы проданы."}
{"id": 938865, "t": "Прибери пыль на этажерке."}
{"id": 939612, "t": "Кино вот-вот начнётся."}
{"id": 939945, "t": "Я не ранняя пташка."}
{"id": 940093, "t": "Мне нравится купаться в море."}
{"id": 940095, "t": "Играть в карты интересно."}
{"id": 940320, "t": "Мне пришлось работать в воскресенье."}
{"id": 940619, "t": "Я пьян."}
{"id": 941009, "t": "Эта книга новая."}
{"id": 941075, "t": "Об этом я забыл."}
{"id": 941099, "t": "Телефонируй мне, если ты найдешь что-то."}
{"id": 942220, "t": "Кот был на столе."}
{"id": 943010, "t": "Некоторые люди любят одиночество."}
{"id": 943011, "t": "Некоторым нравится одиночество."}
{"id": 943299, "t": "У неё нет уверенности в завтрашнем дне."}
{"id": 943324, "t": "Удивительно, что ты ничего не слышал о её свадьбе."}
{"id": 943773, "t": "Я помню это слово."}
{"id": 943927, "t": "Цветение абрикосов в самом разгаре."}
{"id": 943938, "t": "Ты женат?"}
{"id": 944481, "t": "Это просто."}
{"id": 944707, "t": "Не подскажете, который час?"}
{"id": 944721, "t": "У меня достаточно денег, чтобы купить машину."}
{"id": 945060, "t": "Следуйте за мной, пожалуйста."}
{"id": 945063, "t": "Пойдём со мной."}
{"id": 945335, "t": "Книг у моего отца много."}
{"id": 945345, "t": "Нравится ли тебе Сан-Франциско?"}
{"id": 945352, "t": "Времени у нас много."}
{"id": 945364, "t": "Сколько студентов в твоём университете?"}
{"id": 945382, "t": "Это моя сестра."}
{"id": 945393, "t": "Разве я не говорил тебе об этом раньше?"}
{"id": 945492, "t": "Думаю, скоро пойдёт дождь."}
{"id": 945583, "t": "Некоторые дети не любят овощи."}
{"id": 945584, "t": "Дети на пляже строят замок из песка."}
{"id": 945604, "t": "Она волнуется за твою безопасность."}
{"id": 945611, "t": "Это комната номер 839."}
{"id": 945626, "t": "Сколько букв в английском алфавите?"}
{"id": 945628, "t": "Когда оно закончилось?"}
{"id": 946663, "t": "Янки - наши друзья."}
{"id": 947865, "t": "Позвольте представить мою супругу."}
{"id": 949460, "t": "Вот мой электронный адрес."}
{"id": 949556, "t": "Кто твой любимый писатель?"}
{"id": 949674, "t": "Ты будешь моим зятем."}
{"id": 951468, "t": "Я люблю тебя больше, чем ты меня."}
{"id": 951469, "t": "Я люблю тебя больше, чем кого бы то ни было."}
{"id": 951471, "t": "Я бы мог сказать, что люблю тебя, но это было бы ложью."}
{"id": 951960, "t": "Он был синим от холода."}
{"id": 951961, "t": "Один новый, другой старый."}
{"id": 951963, "t": "Мой отец - врач."}
{"id": 951966, "t": "Луна - единственный спутник Земли."}
{"id": 951978, "t": "Я люблю музыку, особенно классическую."}
{"id": 952092, "t": "Простите, где яйца?"}
{"id": 952228, "t": "Ему не понравилась идея."}
{"id": 952284, "t": "Похоже, он покинул страну."}
{"id": 952286, "t": "Знает ли он о сложности?"}
{"id": 952742, "t": "Всё-таки он был прав."}
{"id": 952745, "t": "Для меня это имеет небольшое значение, веришь ли ты в это или нет."}
{"id": 952746, "t": "Как он отреагировал на плохие новости?"}
{"id": 952886, "t": "Жизнь коротка."}
{"id": 952890, "t": "Ей это нужно."}
{"id": 952910, "t": "Что ты сделал за эту неделю?"}
{"id": 952911, "t": "Тебе это нужно."}
{"id": 952915, "t": "Завтра выходной."}
{"id": 952921, "t": "Это мой дом."}
{"id": 952961, "t": "Растения были повреждены морозом."}
{"id": 952964, "t": "Пропавший ребёнок был найден через два дня."}
{"id": 952971, "t": "Он преподаёт английский."}
{"id": 952974, "t": "Это любовь?"}
{"id": 952977, "t": "Было холодно, и мы разожгли костёр."}
{"id": 952980, "t": "Я спрятался под столом."}
{"id": 953008, "t": "Это слово перевести очень трудно."}
{"id": 953010, "t": "Что делала твоя мать, когда ты пришёл домой?"}
{"id": 953013, "t": "Я решил, что мы не пойдём."}
{"id": 953015, "t": "Эта рыба ещё живая?"}
{"id": 953017, "t": "Ты уже не ребёнок."}
{"id": 953023, "t": "Я должен одну купить."}
{"id": 953030, "t": "Всё живое однажды умрёт."}
{"id": 953032, "t": "Он не обратил внимания на то, что она сказала."}
{"id": 953034, "t": "Сколько у тебя шапок?"}
{"id": 953038, "t": "У меня две книги."}
{"id": 953041, "t": "Господин стоял перед банком."}
{"id": 953046, "t": "Верь мне."}
{"id": 953056, "t": "Нет нужды плакать как ребёнок."}
{"id": 955493, "t": "Сыграй мне Шопена."}
{"id": 955602, "t": "Он ведёт дневник на английском языке."}
{"id": 955604, "t": "Он поклялся бросить курить."}
{"id": 956177, "t": "Когда вы идёте домой пешком?"}
{"id": 956180, "t": "Давай помогать друг другу."}
{"id": 956184, "t": "Три миллиона человек оказались без работы."}
{"id": 956185, "t": "Не жалуйся. Ты должен идти."}
{"id": 956189, "t": "Становится всё темнее и темнее."}
{"id": 956190, "t": "Темнеет всё больше и больше."}
{"id": 956192, "t": "Во сне я встретила волка."}
{"id": 956194, "t": "Она столкнула его с причала."}
{"id": 956196, "t": "Вы когда-нибудь видели такой замечательный фильм?"}
{"id": 956199, "t": "Вам доводилось видеть фильм такого хорошего качества?"}
{"id": 956200, "t": "Ненависть - это раковая опухоль на теле общества."}
{"id": 956206, "t": "Эта тема не относится к моим любимым."}
{"id": 956209, "t": "Эту тему нельзя назвать моей любимой."}
{"id": 956215, "t": "Какое твоё любимое блюдо китайской кухни?"}
{"id": 956219, "t": "У этого учителя я не научился ничему."}
{"id": 958517, "t": "Прошлое воскресенье я провел, читая новеллы."}
{"id": 958523, "t": "Он фотогеничен."}
{"id": 958536, "t": "Не двигайтесь."}
{"id": 958545, "t": "Он снова будет здесь."}
{"id": 958547, "t": "Он младше меня на два года."}
{"id": 958554, "t": "В любом случае слишком поздно."}
{"id": 958563, "t": "Я открыл счёт на имя своей дочери."}
{"id": 961420, "t": "Я хочу узнать."}
{"id": 961423, "t": "Интересно."}
{"id": 961774, "t": "Что изобрёл Белл?"}
{"id": 961777, "t": "В Японии левостороннее движение."}
{"id": 961779, "t": "Учительница следила за мной, считая, что я списываю."}
{"id": 961782, "t": "Не разговаривай со мной!"}
{"id": 961793, "t": "Хавьер покраснел."}
{"id": 961795, "t": "Похолодало."}
{"id": 962553, "t": "Я прибавляю в весе."}
